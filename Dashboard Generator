function renderPlan(){
  var cont=document.getElementById('plan-content');if(!cont)return;
  var days=planWeeks[activeWk]||[];
  var html='';
  days.forEach(function(day){
    var allDone=day.tasks.every(function(t){return pChk[t.id];});
    var cls='dc'+(day.wk?' wk':'')+(day.isPX?' pe':'')+(day.isEOREDay?' ed':'')+(day.isPrepDay&&!day.isEOREDay?' pp':'');
    html+='<div class="'+cls+'">';
    if(day.isPX) html+='<div class="banner bbl">PRACTICE EXAM -- Full 120-Question PANCE Simulation</div>';
    if(day.isEOREDay) html+='<div class="banner bpk">EORE TODAY</div>';
    if(day.isPrepDay&&!day.isEOREDay) html+='<div class="banner bor">EORE PREP DAY</div>';
    html+='<div class="dh"><span class="dday">'+day.dy+'</span><span class="ddate">'+day.dt+'</span>'+(allDone?'<span class="okbadge">done</span>':'')+'<span class="dtime">'+(day.wk?weHours+' hrs':wdHours+' hrs')+'</span></div><div class="tlist">';
    day.tasks.forEach(function(t){
      var done=!!pChk[t.id];
      var cb='<input type="checkbox" class="plan-cb" data-tid="'+t.id+'" '+(done?'checked':'')+' />';
      var lbl='<label class="tlab'+(done?' dn':'')+'" data-for="'+t.id+'">'+t.l+'</label>';
      html+='<div class="ti">'+cb+lbl+'</div>';
    });
    html+='</div></div>';
  });
  cont.innerHTML=html;
  // Attach events after render
  cont.querySelectorAll('.plan-cb').forEach(function(cb){
    cb.addEventListener('change',function(){togP(this.getAttribute('data-tid'));});
  });
  cont.querySelectorAll('label[data-for]').forEach(function(lbl){
    lbl.addEventListener('click',function(){
      var id=this.getAttribute('data-for');
      var cb=cont.querySelector('[data-tid="'+id+'"]');
      if(cb){cb.checked=!cb.checked;togP(id);}
    });
  });
}

function togP(id){pChk[id]=!pChk[id];save(PSK,pChk);updatePlanStats();renderPlan();}

