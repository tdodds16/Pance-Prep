    html+='<button class="ibtn nma-del-btn" data-eid="'+e.id+'" title="Delete">&#128465;</button>';
    html+='</div></div>';
  });
  cont.innerHTML=html;
  cont.querySelectorAll('.nma-rvd-btn').forEach(function(b){b.addEventListener('click',function(){togRvd(this.getAttribute('data-eid'));});});
  cont.querySelectorAll('.nma-del-btn').forEach(function(b){b.addEventListener('click',function(){delNMA(this.getAttribute('data-eid'));});});
