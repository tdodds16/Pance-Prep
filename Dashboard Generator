  var cont=document.getElementById('mn-list');if(!cont)return;
  var q=(document.getElementById('mn-search')||{}).value||'';
  var ql=q.toLowerCase();
  var list=allMnemonics();
  if(mnFilt!=='All')list=list.filter(function(m){return m.cat===mnFilt;});
  if(ql)list=list.filter(function(m){return(m.name+m.topic+m.body+m.cat).toLowerCase().indexOf(ql)>=0;});
  if(!list.length){cont.innerHTML='<div class="empty">No mnemonics found.</div>';return;}
  var html='';
  list.forEach(function(m){
    var bg=catBg[m.cat]||'#eee',tc=catTx[m.cat]||'#444';
    html+='<div style="background:var(--bg);border:.5px solid var(--border);border-radius:var(--rl);padding:.75rem 1rem;margin-bottom:7px">';
    html+='<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:5px">';
    html+='<div><span style="font-size:15px;font-weight:600;color:var(--text);font-family:monospace">'+m.name+'</span>';
    html+='<span style="font-size:11px;color:var(--text2);margin-left:8px">'+m.topic+'</span></div>';
    html+='<span style="font-size:10px;padding:2px 7px;border-radius:3px;background:'+bg+';color:'+tc+';white-space:nowrap">'+m.cat+'</span>';
    html+='</div>';
    html+='<div style="font-size:12px;color:var(--text);line-height:1.8;background:var(--bg2);padding:8px 10px;border-radius:var(--r);margin-top:4px;white-space:pre-wrap">'+m.body+'</div>';
    if(m.custom) html+='<button class="mn-del-btn" data-mid="'+m.id+'" style="margin-top:6px;font-size:10px;color:var(--text3);background:none;border:none;cursor:pointer;padding:0">remove</button>';
    html+='</div>';
  });
  cont.innerHTML=html;
  cont.querySelectorAll('.mn-del-btn').forEach(function(b){b.addEventListener('click',function(){deleteMnemonic(this.getAttribute('data-mid'));});});
}

function addMnemonic(){var name=document.getElementById('mn-name').value.trim();var cat=document.getElementById('mn-cat').value;var body=document.getElementById('mn-body').value.trim();var topic=document.getElementById('mn-topic').value.trim();var err=document.getElementById('mn-err');if(!name||!body){err.textContent='Name and content required.';return;}if(!cat){err.textContent='Pick a category.';return;}err.textContent='';userMnemonics.unshift({id:uid(),cat:cat,name:name,topic:topic,body:body,custom:true});save(MNSK,userMnemonics);document.getElementById('mn-name').value='';document.getElementById('mn-cat').value='';document.getElementById('mn-body').value='';document.getElementById('mn-topic').value='';renderMnemonicFilters();renderMnemonics();}
function deleteMnemonic(id){userMnemonics=userMnemonics.filter(function(m){return m.id!==id;});save(MNSK,userMnemonics);renderMnemonicFilters();renderMnemonics();}

// COUNTDOWN
function updateCountdown(){
  var examD=new Date(examISO+'T08:00:00');
  var startD=new Date(startISO+'T00:00:00');
  var now=new Date();
  var diff=examD-now;
  if(diff<=0){document.getElementById('cd-days').textContent='0';document.getElementById('cd-hours').textContent='00';document.getElementById('cd-mins').textContent='00';document.getElementById('cd-secs').textContent='00';document.getElementById('cd-pct').textContent='Exam day!';document.getElementById('cd-bar').style.width='100%';return;}
  var days=Math.floor(diff/864e5);
  var hours=Math.floor((diff%864e5)/36e5);
  var mins=Math.floor((diff%36e5)/6e4);
  var secs=Math.floor((diff%6e4)/1e3);
  document.getElementById('cd-days').textContent=days;
  document.getElementById('cd-hours').textContent=String(hours).padStart(2,'0');
  document.getElementById('cd-mins').textContent=String(mins).padStart(2,'0');
  document.getElementById('cd-secs').textContent=String(secs).padStart(2,'0');
  var totalPrep=examD-startD;
  var elapsed=now-startD;
  var pct=Math.min(100,Math.max(0,Math.round(elapsed/totalPrep*100)));
  document.getElementById('cd-bar').style.width=pct+'%';
  document.getElementById('cd-pct').textContent=pct+'% of prep time used';
}
updateCountdown();
setInterval(updateCountdown,1000);

