function renderNMA(){
  var cont=document.getElementById('nma-list');if(!cont)return;
  var sort=document.getElementById('nma-sort').value;
  var list=nmaData.slice();
  if(nmaFilt!=='All')list=list.filter(function(e){return e.cat===nmaFilt;});
  list.sort(function(a,b){
    if(sort==='newest')return new Date(b.date)-new Date(a.date);
    if(sort==='oldest')return new Date(a.date)-new Date(b.date);
    if(sort==='category')return a.cat.localeCompare(b.cat);
    if(sort==='unreviewed')return(a.reviewed?1:0)-(b.reviewed?1:0);
    return 0;
  });
  if(!list.length){cont.innerHTML='<div class="empty">No entries yet.</div>';return;}
  var html='',lastCat='',byCat=sort==='category';
  list.forEach(function(e){
    if(byCat&&e.cat!==lastCat){html+='<div class="sechdr">'+e.cat+'</div>';lastCat=e.cat;}
    var bg=catBg[e.cat]||'#eee',tc=catTx[e.cat]||'#444';
    var dt=new Date(e.date).toLocaleDateString('en-US',{month:'short',day:'numeric'});
    html+='<div class="nmaentry" data-eid="'+e.id+'">';
    html+='<div class="nmaeb">';
    html+='<div class="nmaet'+(e.reviewed?' rv':'')+'">'+e.hook+'</div>';
    html+='<div class="nmaem"><span class="nmacat" style="background:'+bg+';color:'+tc+'">'+e.cat+'</span><span class="nmadt">'+dt+'</span></div>';
