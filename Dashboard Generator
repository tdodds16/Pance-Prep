var activeWk=0;

function allPIds(){var ids=[];plan.forEach(function(d){d.tasks.forEach(function(t){ids.push(t.id);});});return ids;}
function updatePlanStats(){
  var all=allPIds(),done=all.filter(function(id){return pChk[id];}).length;
  var pct=Math.round(done/all.length*100);
  document.getElementById('p-pb').style.width=pct+'%';
  document.getElementById('p-pct').textContent=pct+'%';
  document.getElementById('p-done').textContent=done;
  document.getElementById('p-left').textContent=all.length-done;
