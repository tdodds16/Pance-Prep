<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PANCE Study Dashboard Generator</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#fff;--bg2:#f7f7f5;--bg3:#f0f0ec;
  --text:#1a1a1a;--text2:#6b6b6b;--text3:#9b9b9b;
  --border:rgba(0,0,0,0.12);--border2:rgba(0,0,0,0.22);
  --green:#1D9E75;--red:#A32D2D;
  --r:8px;--rl:12px;
  --font:"Inter",-apple-system,BlinkMacSystemFont,sans-serif;
}
@media(prefers-color-scheme:dark){:root{
  --bg:#1c1c1c;--bg2:#242424;--bg3:#2c2c2c;
  --text:#f0f0f0;--text2:#a0a0a0;--text3:#666;
  --border:rgba(255,255,255,0.1);--border2:rgba(255,255,255,0.2);
}}
body{font-family:var(--font);background:var(--bg3);color:var(--text);min-height:100vh;padding:2rem 1rem}
.wrap{max-width:680px;margin:0 auto}
.card{background:var(--bg);border-radius:var(--rl);padding:1.75rem;margin-bottom:1rem;border:.5px solid var(--border)}
.logo-row{display:flex;align-items:center;gap:12px;margin-bottom:1.5rem}
.logo{width:40px;height:40px;background:var(--green);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:15px;flex-shrink:0}
.app-title{font-size:20px;font-weight:600}
.app-sub{font-size:13px;color:var(--text2);margin-top:2px}
.step-indicator{display:flex;gap:6px;margin-bottom:1.5rem}
.step-dot{width:8px;height:8px;border-radius:50%;background:var(--border2);flex-shrink:0;transition:background .2s}
.step-dot.act{background:var(--green)}
.step-dot.done{background:var(--green);opacity:.4}
.step-title{font-size:16px;font-weight:600;margin-bottom:4px}
.step-sub{font-size:13px;color:var(--text2);margin-bottom:1.25rem;line-height:1.5}
.field-label{font-size:12px;font-weight:500;color:var(--text2);margin-bottom:5px;display:block;text-transform:uppercase;letter-spacing:.04em}
.field-group{margin-bottom:1rem}
.finput{width:100%;font-size:13px;padding:9px 12px;border:.5px solid var(--border);border-radius:var(--r);background:var(--bg2);color:var(--text);font-family:var(--font);outline:none}
.finput:focus{border-color:var(--border2)}
.frow{display:flex;gap:8px;flex-wrap:wrap}
.frow .finput{flex:1;min-width:140px}
.toggle-group{display:flex;gap:8px;flex-wrap:wrap}
.toggle-btn{font-size:12px;padding:7px 14px;border:.5px solid var(--border);border-radius:20px;background:var(--bg);color:var(--text2);cursor:pointer;font-family:var(--font);transition:all .15s;user-select:none}
.toggle-btn.sel{background:var(--green);color:#fff;border-color:var(--green)}
.cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px;margin-top:4px}
.cat-check{display:flex;align-items:center;gap:8px;padding:7px 10px;border:.5px solid var(--border);border-radius:var(--r);cursor:pointer;font-size:12px;background:var(--bg);transition:all .15s}
.cat-check:hover{background:var(--bg2)}
.cat-check.sel{border-color:var(--green);background:#EAF3DE;color:#27500A}
.cat-check input{display:none}
.cat-check .dot{width:14px;height:14px;border-radius:50%;border:1.5px solid var(--border2);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:9px;color:transparent}
.cat-check.sel .dot{background:var(--green);border-color:var(--green);color:#fff}
.nav-row{display:flex;gap:8px;justify-content:space-between;margin-top:1.25rem}
.btn-back{font-size:13px;padding:10px 18px;border:.5px solid var(--border2);border-radius:var(--r);background:var(--bg);color:var(--text2);cursor:pointer;font-family:var(--font)}
.btn-next{font-size:13px;padding:10px 22px;border:none;border-radius:var(--r);background:var(--green);color:#fff;cursor:pointer;font-family:var(--font);font-weight:500}
.btn-next:hover{opacity:.9}
.btn-build{font-size:14px;padding:12px 28px;border:none;border-radius:var(--r);background:var(--green);color:#fff;cursor:pointer;font-family:var(--font);font-weight:600;width:100%;margin-top:1rem}
.errmsg{font-size:11px;color:var(--red);margin-top:4px;display:none}
.summary-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:.5px solid var(--border);font-size:13px}
.summary-row:last-child{border:none}
.summary-lbl{color:var(--text2)}
.summary-val{font-weight:500;text-align:right;max-width:60%}
.hidden{display:none}
.progress-wrap{text-align:center;padding:2rem}
.progress-spinner{width:48px;height:48px;border:3px solid var(--border);border-top-color:var(--green);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 1rem}
@keyframes spin{to{transform:rotate(360deg)}}
.result-card{background:var(--bg);border-radius:var(--rl);padding:2rem;text-align:center;border:.5px solid var(--border)}
.result-icon{font-size:48px;margin-bottom:1rem}
.result-title{font-size:20px;font-weight:600;margin-bottom:6px}
.result-sub{font-size:13px;color:var(--text2);margin-bottom:1.5rem;line-height:1.5}
.btn-download{font-size:14px;padding:12px 28px;border:none;border-radius:var(--r);background:var(--green);color:#fff;cursor:pointer;font-family:var(--font);font-weight:600;display:inline-block;text-decoration:none}
.hours-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
select.finput{cursor:pointer}
.info-note{font-size:11px;color:var(--text3);margin-top:4px;line-height:1.4}
</style>
</head>
<body>
<div class="wrap">
  <div class="card">
    <div class="logo-row">
      <div class="logo">PA</div>
      <div><div class="app-title">PANCE Dashboard Generator</div><div class="app-sub">Build a personalized study dashboard in 2 minutes</div></div>
    </div>

    <div class="step-indicator" id="step-dots"></div>

    <!-- STEP 1: Basics -->
    <div id="step-1">
      <div class="step-title">Let's start with the basics</div>
      <div class="step-sub">Your name, exam date, and how much time you have to study each day.</div>

      <div class="field-group">
        <label class="field-label">Your name</label>
        <input class="finput" type="text" id="s1-name" placeholder="e.g. Alex Johnson">
        <div class="errmsg" id="err-name">Please enter your name.</div>
      </div>

      <div class="field-group">
        <label class="field-label">PANCE exam date</label>
        <input class="finput" type="date" id="s1-examdate">
        <div class="errmsg" id="err-examdate">Please enter your exam date.</div>
      </div>

      <div class="field-group">
        <label class="field-label">Daily study time available</label>
        <div class="hours-row">
          <div>
            <label class="field-label" style="font-size:11px;margin-bottom:4px">Weekdays</label>
            <select class="finput" id="s1-wdhr">
              <option value="1">1 hour</option>
              <option value="1.5" selected>1.5 hours</option>
              <option value="2">2 hours</option>
              <option value="2.5">2.5 hours</option>
              <option value="3">3 hours</option>
              <option value="4">4+ hours</option>
            </select>
          </div>
          <div>
            <label class="field-label" style="font-size:11px;margin-bottom:4px">Weekends</label>
            <select class="finput" id="s1-wehr">
              <option value="1.5">1.5 hours</option>
              <option value="2">2 hours</option>
              <option value="3" selected>3 hours</option>
              <option value="4">4 hours</option>
              <option value="5">5+ hours</option>
            </select>
          </div>
        </div>
      </div>

      <div class="nav-row">
        <div></div>
        <button class="btn-next" onclick="goStep(2)">Next &rarr;</button>
      </div>
    </div>

    <!-- STEP 2: Tools -->
    <div id="step-2" class="hidden">
      <div class="step-title">What tools are you using?</div>
      <div class="step-sub">Select everything that applies. Your plan will only include tasks for tools you actually use.</div>

      <div class="field-group">
        <label class="field-label">Question bank</label>
        <div class="toggle-group">
          <div class="toggle-btn sel" data-group="qbank" data-val="rosh" onclick="toggleSingle(this)">Rosh Review</div>
          <div class="toggle-btn" data-group="qbank" data-val="uworld" onclick="toggleSingle(this)">UWorld</div>
          <div class="toggle-btn" data-group="qbank" data-val="amboss" onclick="toggleSingle(this)">AMBOSS</div>
          <div class="toggle-btn" data-group="qbank" data-val="other" onclick="toggleSingle(this)">Other</div>
        </div>
        <div class="errmsg" id="err-qbank">Please select a question bank.</div>
      </div>

      <div class="field-group">
        <label class="field-label">Flashcards / Anki</label>
        <div class="toggle-group">
          <div class="toggle-btn sel" data-group="anki" data-val="yes" onclick="toggleBool(this,'anki')">Yes, I use Anki</div>
          <div class="toggle-btn" data-group="anki" data-val="no" onclick="toggleBool(this,'anki')">No Anki</div>
        </div>
      </div>

      <div class="field-group">
        <label class="field-label">Video resources</label>
        <div class="toggle-group">
          <div class="toggle-btn sel" data-group="vid" data-val="ctp" onclick="toggleMulti(this)">Cram the PANCE</div>
          <div class="toggle-btn" data-group="vid" data-val="hippo" onclick="toggleMulti(this)">Hippo Education</div>
          <div class="toggle-btn" data-group="vid" data-val="youtube" onclick="toggleMulti(this)">YouTube (other)</div>
          <div class="toggle-btn" data-group="vid" data-val="none" onclick="toggleNone(this,'vid')">No videos</div>
        </div>
      </div>

      <div class="field-group">
        <label class="field-label">Practice exams planned?</label>
        <div class="toggle-group">
          <div class="toggle-btn sel" data-group="px" data-val="yes" onclick="toggleBool(this,'px')">Yes</div>
          <div class="toggle-btn" data-group="px" data-val="no" onclick="toggleBool(this,'px')">No</div>
        </div>
        <div class="info-note">If yes, we'll schedule two full 120-question practice exams at strategic points in your plan.</div>
      </div>

      <div class="nav-row">
        <button class="btn-back" onclick="goStep(1)">&larr; Back</button>
        <button class="btn-next" onclick="goStep(3)">Next &rarr;</button>
      </div>
    </div>

    <!-- STEP 3: EOREs -->
    <div id="step-3" class="hidden">
      <div class="step-title">Do you have any EOREs coming up?</div>
      <div class="step-sub">End of Rotation Exams before your PANCE. We'll build focused prep blocks before each one.</div>

      <div class="field-group">
        <label class="field-label">EORE exams (select all that apply)</label>
        <div class="toggle-group" style="flex-wrap:wrap">
          <div class="toggle-btn" data-group="eore" data-val="peds" onclick="toggleMulti(this)">Pediatrics</div>
          <div class="toggle-btn" data-group="eore" data-val="womens" onclick="toggleMulti(this)">Women's Health</div>
          <div class="toggle-btn" data-group="eore" data-val="fammed" onclick="toggleMulti(this)">Family Medicine</div>
          <div class="toggle-btn" data-group="eore" data-val="im" onclick="toggleMulti(this)">Internal Medicine</div>
          <div class="toggle-btn" data-group="eore" data-val="surgery" onclick="toggleMulti(this)">Surgery</div>
          <div class="toggle-btn" data-group="eore" data-val="em" onclick="toggleMulti(this)">Emergency Medicine</div>
          <div class="toggle-btn" data-group="eore" data-val="psych" onclick="toggleMulti(this)">Psychiatry</div>
          <div class="toggle-btn" data-group="eore" data-val="none" onclick="toggleNone(this,'eore')">No EOREs</div>
        </div>
      </div>

      <div id="eore-dates-section" class="hidden">
        <label class="field-label" style="margin-bottom:8px">EORE dates</label>
        <div id="eore-date-inputs"></div>
      </div>

      <div class="nav-row">
        <button class="btn-back" onclick="goStep(2)">&larr; Back</button>
        <button class="btn-next" onclick="goStep(4)">Next &rarr;</button>
      </div>
    </div>

    <!-- STEP 4: PACKRAT -->
    <div id="step-4" class="hidden">
      <div class="step-title">Add your PACKRAT scores <span style="font-size:13px;font-weight:400;color:var(--text2)">(optional)</span></div>
      <div class="step-sub">If you have PACKRAT results, enter your percentage score per category below. We will cross-reference these with the national mean and automatically flag weak areas in your plan. Skip any category you do not have data for.</div>

      <div style="background:var(--bg2);border-radius:var(--r);padding:10px 12px;margin-bottom:1rem;font-size:12px;color:var(--text2);line-height:1.5">
        Find your scores on your PACKRAT Individual Student Report. Enter the percentage shown in the "Your Performance" column for each category.
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px" id="packrat-inputs"></div>

      <div style="margin-top:1rem" class="field-group">
        <label class="field-label">Overall PACKRAT score <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px">(optional)</span></label>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <input class="finput" type="number" id="pr-overall" min="100" max="225" placeholder="e.g. 147" style="width:130px">
          <span style="font-size:12px;color:var(--text2)">National mean (under 10 months to graduation): ~163</span>
        </div>
      </div>

      <div class="nav-row">
        <button class="btn-back" onclick="goStep(3)">&larr; Back</button>
        <button class="btn-next" onclick="goStep(5)">Next &rarr;</button>
      </div>
    </div>


    <!-- STEP 5: Weak areas -->
    <div id="step-5" class="hidden">
      <div class="step-title">Where do you need the most help?</div>
      <div class="step-sub">Select every category you feel shaky in. These will get more Rosh blocks, more video time, and more review tasks. Don't be shy — better to over-select than under.</div>

      <div id="packrat-auto-note" style="display:none;font-size:12px;color:#185FA5;background:#E6F1FB;padding:8px 12px;border-radius:var(--r);margin-bottom:10px;border:.5px solid #B5D4F4"></div>
      <div class="field-group">
        <label class="field-label">Weak categories (select all that apply)</label>
        <div class="cat-grid" id="weak-cats"></div>
      </div>

      <div class="field-group" style="margin-top:1rem">
        <label class="field-label">Strong categories to deprioritize</label>
        <div class="cat-grid" id="strong-cats"></div>
        <div class="info-note">These will still appear in your plan but with lighter coverage so you maintain what you know.</div>
      </div>

      <div class="nav-row">
        <button class="btn-back" onclick="goStep(4)">&larr; Back</button>
        <button class="btn-next" onclick="goStep(6)">Next &rarr;</button>
      </div>
    </div>

    <!-- STEP 6: Review -->
    <div id="step-6" class="hidden">
      <div class="step-title">Review your setup</div>
      <div class="step-sub">Everything look right? Hit Build Dashboard to generate your personalized plan.</div>
      <div id="summary"></div>
      <button class="btn-build" onclick="buildDashboard()">&#9881; Build my dashboard</button>
      <div class="nav-row">
        <button class="btn-back" onclick="goStep(5)">&larr; Back</button>
        <div></div>
      </div>
    </div>

    <!-- BUILDING -->
    <div id="step-building" class="hidden">
      <div class="progress-wrap">
        <div class="progress-spinner"></div>
        <div style="font-size:15px;font-weight:500;margin-bottom:6px">Building your dashboard...</div>
        <div style="font-size:13px;color:var(--text2)" id="build-status">Calculating your study schedule...</div>
      </div>
    </div>

    <!-- DONE -->
    <div id="step-done" class="hidden">
      <div class="result-card">
        <div class="result-icon">&#127881;</div>
        <div class="result-title">Your dashboard is ready!</div>
        <div class="result-sub" id="done-summary">Your personalized PANCE study plan has been generated. Download it and open it in any browser — no internet needed.</div>
        <a id="download-link" href="#" download="PANCE_Dashboard.html" class="btn-download">&#11015; Download Dashboard</a>
        <div style="font-size:11px;color:var(--text3);margin-top:12px">Opens in any browser. Progress saves automatically to that browser.</div>
      </div>
    </div>

  </div>
</div>

<script>
var TOTAL_STEPS = 6;
var currentStep = 1;

var CATS = [
  'Cardiovascular','Dermatologic','Endocrine','Eyes, Ears, Nose, Throat',
  'Gastrointestinal / Nutrition','Genitourinary','Hematologic','Infectious Disease',
  'Musculoskeletal','Neurologic','Psychiatry','Pulmonary','Renal','Reproductive','Professional Practice'
];

var EORE_LABELS = {
  peds:'Pediatrics', womens:"Womens Health", fammed:'Family Medicine',
  im:'Internal Medicine', surgery:'Surgery', em:'Emergency Medicine', psych:'Psychiatry'
};


// PACKRAT categories with national means (PACKRAT v30 national mean <10 months)
var PACKRAT_CATS = [
  {key:'cardiology', label:'Cardiology', mean:77, bpCat:'Cardiovascular'},
  {key:'pulmonology', label:'Pulmonology', mean:74, bpCat:'Pulmonary'},
  {key:'gi', label:'Gastrointestinal / Nutritional', mean:65, bpCat:'Gastrointestinal / Nutrition'},
  {key:'ortho', label:'Orthopedics / Rheumatology', mean:69, bpCat:'Musculoskeletal'},
  {key:'ent', label:'ENT / Ophthalmology', mean:72, bpCat:'Eyes, Ears, Nose, Throat'},
  {key:'obgyn', label:'Obstetrics / Gynecology', mean:67, bpCat:'Reproductive'},
  {key:'endo', label:'Endocrinology', mean:83, bpCat:'Endocrine'},
  {key:'neuro', label:'Neurology', mean:75, bpCat:'Neurologic'},
  {key:'psych', label:'Psychiatry / Behavioral', mean:79, bpCat:'Psychiatry'},
  {key:'renal', label:'Urology / Renal', mean:78, bpCat:'Renal'},
  {key:'derm', label:'Dermatology', mean:67, bpCat:'Dermatologic'},
  {key:'heme', label:'Hematology', mean:68, bpCat:'Hematologic'},
  {key:'id', label:'Infectious Diseases', mean:58, bpCat:'Infectious Disease'},
];

function initPackratInputs() {
  var cont = document.getElementById('packrat-inputs');
  if (!cont) return;
  cont.innerHTML = '';
  PACKRAT_CATS.forEach(function(cat) {
    var div = document.createElement('div');
    div.style.cssText = 'background:var(--bg);border:.5px solid var(--border);border-radius:var(--r);padding:8px 10px';
    var mean = cat.mean;
    div.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">' +
      '<span style="font-size:12px;font-weight:500;color:var(--text)">' + cat.label + '</span>' +
      '<span style="font-size:10px;color:var(--text3)">mean: ' + mean + '%</span>' +
      '</div>' +
      '<div style="display:flex;align-items:center;gap:6px">' +
      '<input type="number" id="pr-' + cat.key + '" min="0" max="100" placeholder="your %" ' +
      'style="width:75px;font-size:14px;font-weight:500;padding:5px 8px;border:.5px solid var(--border);border-radius:var(--r);background:var(--bg2);color:var(--text);font-family:var(--font);outline:none" ' +
      'onchange="updatePackratField(\'' + cat.key + '\',this.value,' + mean + ')" />' +
      '<div id="pr-bar-' + cat.key + '" style="flex:1;height:6px;background:var(--bg2);border-radius:3px;overflow:hidden"><div id="pr-fill-' + cat.key + '" style="height:6px;border-radius:3px;width:0%;background:var(--green);transition:width .3s"></div></div>' +
      '<span id="pr-flag-' + cat.key + '" style="font-size:10px;width:50px;text-align:right;color:var(--text3)"></span>' +
      '</div>';
    cont.appendChild(div);
  });
}

function updatePackratField(key, val, mean) {
  var n = parseFloat(val);
  state.packrat[key] = isNaN(n) ? null : n;
  var fill = document.getElementById('pr-fill-' + key);
  var flag = document.getElementById('pr-flag-' + key);
  if (!fill || !flag) return;
  if (isNaN(n) || val === '') { fill.style.width='0%'; flag.textContent=''; return; }
  fill.style.width = Math.min(100,n) + '%';
  var diff = n - mean;
  if (diff < -20) { fill.style.background='#A32D2D'; flag.textContent='critical'; flag.style.color='#A32D2D'; }
  else if (diff < -10) { fill.style.background='#C07000'; flag.textContent='weak'; flag.style.color='#C07000'; }
  else if (diff < 0) { fill.style.background='#E0A020'; flag.textContent='below'; flag.style.color='#E0A020'; }
  else { fill.style.background='#1D9E75'; flag.textContent='ok'; flag.style.color='#1D9E75'; }
}

function getPackratWeakCats() {
  // Returns blueprint categories that PACKRAT identifies as weak (below mean by 10+)
  var weak = [];
  PACKRAT_CATS.forEach(function(cat) {
    var score = state.packrat[cat.key];
    if (score !== null && score !== undefined) {
      if (score < cat.mean - 10) {
        if (weak.indexOf(cat.bpCat) < 0) weak.push(cat.bpCat);
      }
    }
  });
  return weak;
}

function getPackratCriticalCats() {
  // Critically weak: 20+ below mean
  var crit = [];
  PACKRAT_CATS.forEach(function(cat) {
    var score = state.packrat[cat.key];
    if (score !== null && score !== undefined) {
      if (score < cat.mean - 20) {
        if (crit.indexOf(cat.bpCat) < 0) crit.push(cat.bpCat);
      }
    }
  });
  return crit;
}


var CTP_EPISODES = {
  'Cardiovascular':['S1E16 Cardiomyopathy','S1E17 Congenital Heart Disease','S1E18 Endocarditis','S1E19 Hypertension','S1E20 HTN Medications','S1E21 Heart Failure','S1E22 Heart Murmurs','S1E23 ACS','S1E24 50 HY Cardiology Questions','S1E51 AV Blocks','S1E56 Antiarrhythmic Drugs'],
  'Dermatologic':['S1E -- Dermatology overview (search Cram the PANCE Dermatology)'],
  'Endocrine':['S1E2 Diabetes','S1E3 Cushing vs Addison','S1E4 Hyperparathyroidism','S1E5 Hyperthyroidism vs Hypothyroidism','S1E6 SIADH vs DI','S1E30 50 HY Endocrine Questions'],
  'Gastrointestinal / Nutrition':['S1E7 UC vs Crohns Disease','S1E8 Pancreatitis','S1E9 Biliary Disorders','S1E11 Gastric Disorders','S1E12-13 Esophageal Disorders','S1E14 Hepatitis','S1E15 Small and Large Bowel','S1E25 50 HY GI Questions'],
  'Genitourinary':['S1E27 50 HY Renal Questions','S1E1 Renal cram session'],
  'Hematologic':['S1E35 Leukemia','S1E36 Thrombocytopenia','S1E37 Anemia','S1E38 Bleeding and Coagulation','S1E39 Lymphoma','S1E40 50 HY Hematology Questions'],
  'Infectious Disease':['S1E28 Tuberculosis','S1E29 Pneumonia','S1E41 Antibiotics','S1E57 Bacterial Disease Review'],
  'Musculoskeletal':['S1E44 MSK Lower Extremity','S1E45 MSK Upper Extremity','S1E46 MSK Rheumatology Part 1','S1E47 MSK Rheumatology Part 2','S1E48 50 HY MSK Questions'],
