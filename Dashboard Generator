// Group plan into weeks
var planWeeks=[];
var wk=[];
plan.forEach(function(d,i){wk.push(d);if(wk.length===7||i===plan.length-1){planWeeks.push(wk);wk=[];}});

function renderWNav(){
  var nav=document.getElementById('wnav');nav.innerHTML='';
  planWeeks.forEach(function(w,i){
    var b=document.createElement('button');
    b.className='wbtn'+(i===activeWk?' act':'');
    b.textContent=wkLabels[i]||('Week '+(i+1));
    b.setAttribute('data-w',i);
    b.onclick=function(){activeWk=parseInt(this.getAttribute('data-w'));renderWNav();renderPlan();};
