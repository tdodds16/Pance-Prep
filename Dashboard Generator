// ── PLAN GENERATOR ──
function generateDashboard(s) {
  var examDate = new Date(s.examDate + 'T08:00:00');
  var today = new Date();
  today.setHours(0,0,0,0);
  var startDate = new Date(today);
  var totalDays = Math.floor((examDate - startDate) / 864e5);

  // Sort eores by date
  var eoresSorted = s.eores.filter(function(e){ return s.eoreDates[e]; }).sort(function(a,b){
    return new Date(s.eoreDates[a]) - new Date(s.eoreDates[b]);
  });

  // Build ordered categories: weak first, then neutral, then strong last
  var allCats = ['Dermatologic','Infectious Disease','Reproductive','Pulmonary','Eyes, Ears, Nose, Throat','Musculoskeletal','Gastrointestinal / Nutrition','Renal','Cardiovascular','Endocrine','Neurologic','Hematologic','Psychiatry','Genitourinary','Professional Practice'];
  var orderedCats = [];
  // weak cats first
  s.weakCats.forEach(function(c){ if(orderedCats.indexOf(c)<0) orderedCats.push(c); });
  // neutral
  allCats.forEach(function(c){ if(s.weakCats.indexOf(c)<0 && s.strongCats.indexOf(c)<0 && orderedCats.indexOf(c)<0) orderedCats.push(c); });
  // strong last
  s.strongCats.forEach(function(c){ if(orderedCats.indexOf(c)<0) orderedCats.push(c); });

  // Merge PACKRAT weak cats into weakCats (PACKRAT takes priority as 'critical')
  var pkCritCats = [];
  var pkWeakCats = [];
  if (s.packrat) {
    var PRCATS = [
      {key:'cardiology',mean:77,bpCat:'Cardiovascular'},{key:'pulmonology',mean:74,bpCat:'Pulmonary'},
      {key:'gi',mean:65,bpCat:'Gastrointestinal / Nutrition'},{key:'ortho',mean:69,bpCat:'Musculoskeletal'},
      {key:'ent',mean:72,bpCat:'Eyes, Ears, Nose, Throat'},{key:'obgyn',mean:67,bpCat:'Reproductive'},
      {key:'endo',mean:83,bpCat:'Endocrine'},{key:'neuro',mean:75,bpCat:'Neurologic'},
      {key:'psych',mean:79,bpCat:'Psychiatry'},{key:'renal',mean:78,bpCat:'Renal'},
      {key:'derm',mean:67,bpCat:'Dermatologic'},{key:'heme',mean:68,bpCat:'Hematologic'},
      {key:'id',mean:58,bpCat:'Infectious Disease'}
    ];
    PRCATS.forEach(function(pc) {
      var score = s.packrat[pc.key];
      if (score !== null && score !== undefined && !isNaN(score)) {
        if (score < pc.mean - 20 && pkCritCats.indexOf(pc.bpCat)<0) pkCritCats.push(pc.bpCat);
        else if (score < pc.mean - 10 && pkWeakCats.indexOf(pc.bpCat)<0) pkWeakCats.push(pc.bpCat);
      }
    });
    // Merge into weakCats/strongCats
    pkCritCats.concat(pkWeakCats).forEach(function(bc) {
      if (s.weakCats.indexOf(bc)<0) s.weakCats.push(bc);
    });
  }

  // Determine priority level for each cat
  function catPriority(c) {
    if (pkCritCats.indexOf(c) >= 0) return 'critical';
    if (s.weakCats.indexOf(c) >= 0) return 'critical';
    if (s.strongCats.indexOf(c) >= 0) return 'maintenance';
    return 'high';
  }

  // EORE map: which cats each EORE covers
  var eoreCats = {
    peds:['Pediatrics','Pulmonary','Infectious Disease'],
    womens:['Reproductive'],
    fammed:['Cardiovascular','Endocrine','Gastrointestinal / Nutrition','Pulmonary','Musculoskeletal','Neurologic','Psychiatry','Dermatologic'],
    im:['Cardiovascular','Pulmonary','Gastrointestinal / Nutrition','Renal','Endocrine','Hematologic','Infectious Disease','Neurologic'],
    surgery:['Gastrointestinal / Nutrition','Musculoskeletal','Genitourinary','Pulmonary'],
    em:['Cardiovascular','Neurologic','Pulmonary','Musculoskeletal','Infectious Disease'],
    psych:['Psychiatry']
  };

  // Build daily plan
  var plan = [];
  var currentCatIdx = 0;
  var practiceExamDays = [];

  // Figure out practice exam placement
  if (s.practiceExams && totalDays >= 14) {
    var px1Day = Math.floor(totalDays * 0.55);
    var px2Day = Math.floor(totalDays * 0.85);
    // Snap to weekend (Saturday)
    var d1 = new Date(startDate); d1.setDate(d1.getDate() + px1Day);
    while (d1.getDay() !== 6) d1.setDate(d1.getDate() + 1);
    var d2 = new Date(startDate); d2.setDate(d2.getDate() + px2Day);
    while (d2.getDay() !== 6) d2.setDate(d2.getDate() + 1);
    practiceExamDays.push(d1.toDateString());
    practiceExamDays.push(d2.toDateString());
  }

  // EORE prep: days before each EORE, insert EORE-specific tasks
  var eorePrepDays = {}; // dateString -> eore key
  var eoreExamDays = {}; // dateString -> eore key
  eoresSorted.forEach(function(e) {
    var ed = new Date(s.eoreDates[e] + 'T12:00:00');
    eoreExamDays[ed.toDateString()] = e;
    // 3 days before = prep days
    for (var i=1; i<=3; i++) {
      var pd = new Date(ed); pd.setDate(pd.getDate()-i);
      if (!eorePrepDays[pd.toDateString()]) eorePrepDays[pd.toDateString()] = [];
      eorePrepDays[pd.toDateString()].push(e);
    }
  });

  // Cat cycling: roughly how many days per cat based on priority
  function daysForCat(c) {
    var p = catPriority(c);
    if (p === 'critical') return Math.max(3, Math.floor(totalDays * 0.08));
    if (p === 'maintenance') return Math.max(1, Math.floor(totalDays * 0.03));
    return Math.max(2, Math.floor(totalDays * 0.05));
  }

  var catSchedule = []; // array of {cat, days} covering all days
  var scheduledDays = 0;
  while (scheduledDays < totalDays) {
    if (currentCatIdx >= orderedCats.length) currentCatIdx = 0;
    var cat = orderedCats[currentCatIdx];
    var d = Math.min(daysForCat(cat), totalDays - scheduledDays);
    catSchedule.push({cat:cat, days:d});
    scheduledDays += d;
    currentCatIdx++;
  }

  // Flatten cat schedule to day->cat map
  var dayCat = {};
  var dayCount = 0;
  catSchedule.forEach(function(cs) {
    for (var i=0; i<cs.days; i++) {
      dayCat[dayCount] = cs.cat;
      dayCount++;
    }
  });

  // CTP episode index per cat
  var ctpIdx = {};
  Object.keys(CTP_EPISODES).forEach(function(k){ ctpIdx[k] = 0; });

  function nextCTP(cat) {
    var eps = CTP_EPISODES[cat] || [];
    if (!eps.length) return null;
    var ep = eps[ctpIdx[cat] % eps.length];
    ctpIdx[cat]++;
    return ep;
  }

  var dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  function formatDate(d) { return monthNames[d.getMonth()] + ' ' + d.getDate(); }
  function isWeekend(d) { return d.getDay() === 0 || d.getDay() === 6; }

  var qbankName = s.qbank === 'rosh' ? 'Rosh' : s.qbank === 'uworld' ? 'UWorld' : s.qbank === 'amboss' ? 'AMBOSS' : 'Question bank';

  // Build each days tasks
  for (var di = 0; di < totalDays; di++) {
    var date = new Date(startDate);
    date.setDate(date.getDate() + di);
    var dateStr = date.toDateString();
    var we = isWeekend(date);
    var cat = dayCat[di] || orderedCats[di % orderedCats.length];
    var pri = catPriority(cat);
    var tasks = [];
    var isPX = practiceExamDays.indexOf(dateStr) >= 0;
    var isEOREDay = !!eoreExamDays[dateStr];
    var isPrepDay = !!eorePrepDays[dateStr];
    var eoreKey = eoreExamDays[dateStr];
    var prepKeys = eorePrepDays[dateStr] || [];

    var id_prefix = 'd' + di + '_';
    var tid = 0;
    function addTask(label) { tasks.push({id: id_prefix + (tid++), l: label}); }

    // Anki
    if (s.anki) {
      if (isEOREDay || (isPrepDay && !we)) {
        addTask('Anki -- daily reviews (15 min, light)' + tag('Anki','#EEEDFE','#3C3489'));
      } else {
        addTask('Anki -- daily reviews' + tag('Anki','#EEEDFE','#3C3489'));
      }
    }

    if (isPX) {
      var pxNum = practiceExamDays.indexOf(dateStr) + 1;
      addTask('TAKE FULL PRACTICE EXAM ' + pxNum + ' -- 120 Qs, strictly timed (2 hrs 40 min), exam conditions' + tag('practice exam ' + pxNum,'#E6F1FB','#185FA5'));
      addTask('Score and categorize every wrong answer by NCCPA blueprint category' + tag('review','#f0f0ec','#6b6b6b'));
      addTask('List your top 5 weakest blueprint categories -- drives your next study block' + tag('review','#f0f0ec','#6b6b6b'));
    } else if (isEOREDay) {
      var eLbl = EORE_LABELS[eoreKey] || eoreKey;
      addTask('TAKE ' + eLbl.toUpperCase() + ' EORE' + tag('exam','#FBEAF0','#993556'));
      addTask('After exam: log all weak topics by name for future ' + qbankName + ' blocks' + tag('review','#f0f0ec','#6b6b6b'));
    } else if (isPrepDay) {
      // EORE prep day
      prepKeys.forEach(function(pk) {
        var eLbl = EORE_LABELS[pk] || pk;
        var eCats = eoreCats[pk] || [];
        eCats.slice(0,2).forEach(function(ec) {
          addTask(qbankName + ' -- ' + ec + ' ' + (we?'25':'15') + ' Qs focused: high-yield ' + eLbl + ' EORE prep' + tag('EORE prep','#FBEAF0','#993556') + tag(pri,'#FAEEDA','#854F0B'));
        });
      });
      // Video
      if (s.videos.indexOf('ctp') >= 0) {
        var ep = nextCTP(prepKeys[0] ? (eoreCats[prepKeys[0]]||[])[0]||cat : cat);
        if (ep) addTask('Listen/Watch -- YouTube or Spotify: ' + ep + tag('Cram the PANCE','#E1F5EE','#0F6E56'));
      } else if (s.videos.length && s.videos.indexOf('none') < 0) {
        addTask('Video review -- ' + cat + ' focused (' + s.videos.join(', ') + ')' + tag('video','#E1F5EE','#0F6E56'));
      }
    } else {
      // Normal study day
      var qCount = we ? 25 : 15;
      var qMode = di > totalDays * 0.5 ? 'timed' : 'untimed, read ALL explanations';
      addTask(qbankName + ' -- ' + cat + ' ' + qCount + ' Qs ' + qMode + tag(qbankName,'#E6F1FB','#185FA5') + tag(pri==='critical'?'critical':pri==='maintenance'?'maintenance':'high priority', pri==='critical'?'#FAECE7':pri==='maintenance'?'#EAF3DE':'#FAEEDA', pri==='critical'?'#993C1D':pri==='maintenance'?'#3B6D11':'#854F0B'));

      // Video
      if (s.videos.indexOf('ctp') >= 0) {
        var ep2 = nextCTP(cat);
        if (ep2) addTask('Listen/Watch -- YouTube or Spotify: ' + ep2 + tag('Cram the PANCE','#E1F5EE','#0F6E56'));
      } else if (s.videos.indexOf('none') < 0 && s.videos.length) {
        addTask('Video review -- ' + cat + ' focused (' + s.videos.join(', ') + ')' + tag('video','#E1F5EE','#0F6E56'));
      }

      // Weekend: second category
      if (we && di > 0) {
        var cat2 = orderedCats[(orderedCats.indexOf(cat) + 1) % orderedCats.length];
        var pri2 = catPriority(cat2);
        addTask(qbankName + ' -- ' + cat2 + ' 20 Qs mixed' + tag(qbankName,'#E6F1FB','#185FA5') + tag(pri2==='critical'?'critical':pri2==='maintenance'?'maintenance':'high priority',pri2==='critical'?'#FAECE7':pri2==='maintenance'?'#EAF3DE':'#FAEEDA',pri2==='critical'?'#993C1D':pri2==='maintenance'?'#3B6D11':'#854F0B'));
      }

      // Timed mixed block on Fridays after week 2
      if (date.getDay() === 5 && di > 14) {
        addTask(qbankName + ' -- Mixed PANCE 20 Qs timed -- all categories' + tag('timed','#E6F1FB','#185FA5'));
      }

      // Review note
      if (pri === 'critical') {
        addTask('Review wrong answers thoroughly -- add one-liners to Never Miss Again tab' + tag('review','#f0f0ec','#6b6b6b'));
      }
    }

    // Final week messaging
    if (di >= totalDays - 2) {
      tasks = [];
      if (s.anki) addTask('Anki -- final light reviews (15 min max)' + tag('Anki','#EEEDFE','#3C3489'));
      if (di === totalDays - 1) {
        addTask('Read through your personal HY notes and quick references -- no new material' + tag('review','#f0f0ec','#6b6b6b'));
        addTask('Confirm logistics: test center, valid ID, arrival time, snacks' + tag('logistics','#f0f0ec','#6b6b6b'));
        addTask('Trust the work. You have done everything right.' + tag('exam eve','#EAF3DE','#3B6D11'));
      } else {
        addTask(qbankName + ' -- Light 20 Qs mixed timed -- confidence builder only' + tag(qbankName,'#E6F1FB','#185FA5'));
        addTask('Review HY drug first-lines and screening guidelines across all categories' + tag('review','#f0f0ec','#6b6b6b'));
      }
    }

    plan.push({
      di: di,
      dy: dayNames[date.getDay()],
      dt: formatDate(date),
      dateStr: dateStr,
      wk: we,
      cat: cat,
      tasks: tasks,
      isPX: isPX,
      isEOREDay: isEOREDay,
      isPrepDay: isPrepDay,
      eoreKey: eoreKey || null,
      prepKeys: prepKeys
    });
  }

  return buildHTML(s, plan, examDate, startDate, totalDays);
}

function tag(txt, bg, col) {
  return '<span style="display:inline-block;font-size:10px;padding:1px 5px;border-radius:3px;margin-left:3px;vertical-align:middle;background:' + bg + ';color:' + col + '">' + txt + '</span>';
}

