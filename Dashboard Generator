function initDots() {
  var d = document.getElementById('step-dots');
  d.innerHTML = '';
  for (var i=1; i<=TOTAL_STEPS; i++) {
    var dot = document.createElement('div');
    dot.className = 'step-dot' + (i===currentStep?' act':i<currentStep?' done':'');
    d.appendChild(dot);
  }
}

function initCatGrids() {
  var wg = document.getElementById('weak-cats');
  var sg = document.getElementById('strong-cats');
  wg.innerHTML = ''; sg.innerHTML = '';
  CATS.forEach(function(c) {
    wg.appendChild(makeCatCheck(c, 'weak'));
    sg.appendChild(makeCatCheck(c, 'strong'));
  });
}

function makeCatCheck(cat, type) {
  var div = document.createElement('div');
  div.className = 'cat-check';
  div.setAttribute('data-cat', cat);
  div.setAttribute('data-type', type);
  div.innerHTML = '<div class="dot">&#10003;</div><span>' + cat + '</span>';
  div.onclick = function() {
    var arr = type === 'weak' ? state.weakCats : state.strongCats;
    var other = type === 'weak' ? state.strongCats : state.weakCats;
    var idx = arr.indexOf(cat);
    var oidx = other.indexOf(cat);
    if (idx >= 0) { arr.splice(idx, 1); div.classList.remove('sel'); }
    else { arr.push(cat); div.classList.add('sel'); if (oidx >= 0) { other.splice(oidx,1); document.querySelector('.cat-check[data-cat="'+cat+'"][data-type="'+(type==="weak"?"strong":"weak")+'"]').classList.remove('sel'); } }
  };
  return div;
}

function toggleSingle(el) {
  var group = el.getAttribute('data-group');
  var val = el.getAttribute('data-val');
  document.querySelectorAll('[data-group="'+group+'"]').forEach(function(b){ b.classList.remove('sel'); });
  el.classList.add('sel');
  state[group] = val;
}

function toggleBool(el, key) {
  var val = el.getAttribute('data-val');
  var group = el.getAttribute('data-group');
  document.querySelectorAll('[data-group="'+group+'"]').forEach(function(b){ b.classList.remove('sel'); });
  el.classList.add('sel');
  state[key] = val === 'yes';
}

function toggleMulti(el) {
  var group = el.getAttribute('data-group');
  var val = el.getAttribute('data-val');
  // deselect "none" if present
  var noneBtn = document.querySelector('[data-group="'+group+'"][data-val="none"]');
  if (noneBtn) noneBtn.classList.remove('sel');
  el.classList.toggle('sel');
  var arr = group === 'eore' ? state.eores : state.videos;
  var idx = arr.indexOf(val);
  if (idx >= 0) arr.splice(idx,1); else arr.push(val);
  if (group === 'eore') updateEoreDates();
}

function toggleNone(el, group) {
  document.querySelectorAll('[data-group="'+group+'"]').forEach(function(b){ b.classList.remove('sel'); });
  el.classList.add('sel');
  if (group === 'eore') { state.eores = []; updateEoreDates(); }
  if (group === 'vid') { state.videos = []; }
}

function updateEoreDates() {
  var sec = document.getElementById('eore-dates-section');
  var inp = document.getElementById('eore-date-inputs');
  if (state.eores.length === 0) { sec.classList.add('hidden'); return; }
