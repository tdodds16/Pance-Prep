function goStep(n) {
  // validate current step before advancing
  if (n > currentStep) {
    if (currentStep === 1) {
      var name = document.getElementById('s1-name').value.trim();
      var ed = document.getElementById('s1-examdate').value;
      var ok = true;
      if (!name) { document.getElementById('err-name').style.display='block'; ok=false; } else { document.getElementById('err-name').style.display='none'; }
      if (!ed) { document.getElementById('err-examdate').style.display='block'; ok=false; } else { document.getElementById('err-examdate').style.display='none'; }
      if (!ok) return;
      state.name = name;
      state.examDate = ed;
      state.wdHours = parseFloat(document.getElementById('s1-wdhr').value);
      state.weHours = parseFloat(document.getElementById('s1-wehr').value);
    }
    if (currentStep === 2) {
      var qsel = document.querySelector('[data-group="qbank"].sel');
      if (!qsel) { document.getElementById('err-qbank').style.display='block'; return; }
      document.getElementById('err-qbank').style.display='none';
      state.qbank = qsel.getAttribute('data-val');
    }
    if (currentStep === 4) {
      // Save packrat overall
      state.packratOverall = document.getElementById('pr-overall').value;
      // Auto-populate weak cats from PACKRAT
      var pkWeak = getPackratWeakCats();
      var pkCrit = getPackratCriticalCats();
      pkWeak.concat(pkCrit).forEach(function(cat) {
        if (state.weakCats.indexOf(cat) < 0) {
          state.weakCats.push(cat);
          var el = document.querySelector('.cat-check[data-cat="' + cat + '"][data-type="weak"]');
          if (el) el.classList.add('sel');
        }
      });
      // Show a note if packrat data was used
      var note = document.getElementById('packrat-auto-note');
      if (note) {
        if (pkWeak.length > 0 || pkCrit.length > 0) {
          note.textContent = 'PACKRAT data auto-selected ' + (pkWeak.length + pkCrit.length) + ' weak categories below. Review and adjust as needed.';
          note.style.display = 'block';
        }
      }
    }
  }
  if (n === 6) buildSummary();
  document.getElementById('step-'+currentStep).classList.add('hidden');
  currentStep = n;
  document.getElementById('step-'+currentStep).classList.remove('hidden');
  initDots();
  window.scrollTo(0,0);
}

function buildSummary() {
  var examFmt = state.examDate ? new Date(state.examDate+'T12:00:00').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) : '--';
  var eoreList = state.eores.length ? state.eores.map(function(e){ var d=state.eoreDates[e]; var dateStr=d?new Date(d+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'}):''; return EORE_LABELS[e]+(dateStr?' ('+dateStr+')':''); }).join(', ') : 'None';
  var vidList = state.videos.length ? state.videos.map(function(v){ return v==='ctp'?'Cram the PANCE':v==='hippo'?'Hippo Education':v==='youtube'?'YouTube':''; }).filter(Boolean).join(', ') : 'None';
  var weakList = state.weakCats.length ? state.weakCats.join(', ') : 'None selected';
  var strongList = state.strongCats.length ? state.strongCats.join(', ') : 'None selected';
  var today = new Date(); var exam = new Date(state.examDate+'T12:00:00');
  var days = Math.max(0, Math.floor((exam-today)/864e5));
  // Build packrat summary
  var prEntries = PACKRAT_CATS.filter(function(cat){ return state.packrat[cat.key] !== null && state.packrat[cat.key] !== undefined; });
  var prSummary = prEntries.length > 0 ? prEntries.map(function(cat){ var s=state.packrat[cat.key]; var diff=s-cat.mean; var flag=diff<-20?'critical':diff<-10?'weak':diff<0?'below avg':'ok'; return cat.label+': '+s+'% ('+flag+')'; }).join(', ') : 'Not entered';
  var prWeak = getPackratWeakCats();
  var prCrit = getPackratCriticalCats();
  var prAutoNote = prWeak.length ? prCrit.length+' critical, '+(prWeak.length-prCrit.length)+' weak categories auto-flagged' : 'No PACKRAT data';

  var rows = [
    ['Student','', state.name],
    ['Exam date','', examFmt],
    ['Days remaining','', days + ' days'],
    ['Weekday study time','', state.wdHours + ' hrs/day'],
    ['Weekend study time','', state.weHours + ' hrs/day'],
    ['Question bank','', state.qbank.charAt(0).toUpperCase()+state.qbank.slice(1)+' Review'],
    ['Anki','', state.anki ? 'Yes' : 'No'],
    ['Videos','', vidList],
    ['Practice exams','', state.practiceExams ? 'Yes (2 full exams scheduled)' : 'No'],
    ['EOREs','', eoreList],
    ['PACKRAT overall','', state.packratOverall ? state.packratOverall + ' / 225' : 'Not entered'],
    ['PACKRAT auto-flagged','', prAutoNote],
    ['Weak categories','', weakList],
    ['Strong (deprioritize)','', strongList],
  ];
  var html = '';
  rows.forEach(function(r){ html += '<div class="summary-row"><span class="summary-lbl">'+r[0]+'</span><span class="summary-val">'+r[2]+'</span></div>'; });
  document.getElementById('summary').innerHTML = html;
}

