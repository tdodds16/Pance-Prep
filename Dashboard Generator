function bpId(cat,grp,item){
  return 'bp_'+(cat+grp+item).replace(/[^a-zA-Z0-9]/g,'_').slice(0,60);
}
function allBpIds(){
  var ids=[];
  blueprintData.forEach(function(c){c.groups.forEach(function(g){g.items.forEach(function(i){ids.push(bpId(c.cat,g.name,i));});});});
  return ids;
}
function updateBpStats(){
  var all=allBpIds(),done=all.filter(function(id){return bpChecked[id];}).length;
  var pct=Math.round(done/all.length*100);
  document.getElementById('bp-total').textContent=all.length;
  document.getElementById('bp-done').textContent=done;
  document.getElementById('bp-left').textContent=all.length-done;
  document.getElementById('bp-pct').textContent=pct+'%';
  document.getElementById('bp-pb').style.width=pct+'%';
  document.getElementById('bp-pblbl').textContent=pct+'% covered ('+done+'/'+all.length+' topics)';
}
function renderBpFilters(){
  var f=document.getElementById('bp-filters');if(!f)return;
  f.innerHTML='';
  var cats=['All'];
  blueprintData.forEach(function(c){cats.push(c.cat);});
  cats.forEach(function(c){
    var b=document.createElement('button');
    b.className='filtbtn'+(bpFilt===c?' act':'');
    b.textContent=c==='All'?'All categories':c;
    b.setAttribute('data-c',c);
    b.onclick=function(){bpFilt=this.getAttribute('data-c');renderBpFilters();renderBlueprint();};
    f.appendChild(b);
  });
}
function togBp(id){
  bpChecked[id]=!bpChecked[id];
  save(BPSK,bpChecked);
  var inp=document.getElementById(id);
  var lbl=document.querySelector('label[data-for-bp="'+id+'"]');
  if(inp) inp.checked=!!bpChecked[id];
  if(lbl) lbl.className='tlab'+(bpChecked[id]?' dn':'');
  updateBpStats();
  // update group counter
  var grpEl=document.getElementById('bpgrp_'+id.split('_').slice(0,4).join('_'));
  if(grpEl){
    // recalculate group done count
    var grpId=id.split('_').slice(0,4).join('_');
    var grpItems=document.querySelectorAll('[id^="'+grpId+'"]');
    var grpDone=0;
    grpItems.forEach(function(el){if(el.tagName==='INPUT'&&el.checked) grpDone++;});
  }
}
function renderBlueprint(){
  var cont=document.getElementById('bp-list');if(!cont)return;
  var list=bpFilt==='All'?blueprintData:blueprintData.filter(function(c){return c.cat===bpFilt;});
  var html='';
  list.forEach(function(catObj){
    var catTotal=0,catDone=0;
    catObj.groups.forEach(function(g){g.items.forEach(function(i){catTotal++;if(bpChecked[bpId(catObj.cat,g.name,i)])catDone++;});});
    var catPct=catTotal?Math.round(catDone/catTotal*100):0;
    html+='<div class="bp-cat">';
    html+='<div class="bp-cat-hdr">';
    html+='<span class="bp-cat-name" style="color:'+catObj.tc+'">'+catObj.cat+'</span>';
    html+='<span class="bp-badge" style="background:'+catObj.color+';color:'+catObj.tc+'">'+catObj.pct+'% of exam</span>';
    html+='<span class="bp-cat-prog">'+catDone+'/'+catTotal+' ('+catPct+'%)</span>';
    html+='</div>';
    html+='<div class="bp-mini-bar-bg"><div style="height:3px;border-radius:3px;background:'+catObj.tc+';width:'+catPct+'%"></div></div>';
    catObj.groups.forEach(function(grp){
      var grpDone=grp.items.filter(function(i){return bpChecked[bpId(catObj.cat,grp.name,i)];}).length;
      html+='<div class="bp-group">';
      html+='<div class="bp-grp-hdr"><span>'+grp.name+'</span><span style="color:var(--text3)">'+grpDone+'/'+grp.items.length+'</span></div>';
      html+='<div class="tlist">';
      grp.items.forEach(function(item){
        var id=bpId(catObj.cat,grp.name,item);
        var done=!!bpChecked[id];
        html+='<div class="ti">';
        html+='<input type="checkbox" class="bp-cb" id="'+id+'" data-bpid="'+id+'" '+(done?'checked':'')+' />';
        html+='<label class="tlab'+(done?' dn':'')+'" data-for-bp="'+id+'">'+item+'</label>';
        html+='</div>';
      });
      html+='</div></div>';
    });
    html+='</div>';
  });
  cont.innerHTML=html;
  // Attach checkbox events
  cont.querySelectorAll('.bp-cb').forEach(function(cb){
    cb.addEventListener('change',function(){togBp(this.getAttribute('data-bpid'));});
  });
  // Attach label click events
  cont.querySelectorAll('label[data-for-bp]').forEach(function(lbl){
    lbl.addEventListener('click',function(){
      var id=this.getAttribute('data-for-bp');
      var cb=document.getElementById(id);
      if(cb){cb.checked=!cb.checked;togBp(id);}
    });
  });
}
renderBpFilters();
renderBlueprint();
updateBpStats();

