  });

  var wkLabelArr = weeks.map(function(w, i) {
    return 'Wk ' + (i+1) + ': ' + w[0].dt + (w.length>1?' - '+w[w.length-1].dt:'');
  });

  var planJSON = JSON.stringify(plan.map(function(d) {
    return {di:d.di,dy:d.dy,dt:d.dt,wk:d.wk,tasks:d.tasks,isPX:d.isPX,isEOREDay:d.isEOREDay,isPrepDay:d.isPrepDay,eoreKey:d.eoreKey,prepKeys:d.prepKeys};
  }));

  var wkLabelsJSON = JSON.stringify(wkLabelArr);
  var examDateStr = examDate.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
  var startDateStr = startDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
  var qbankName = s.qbank === 'rosh' ? 'Rosh' : s.qbank === 'uworld' ? 'UWorld' : s.qbank === 'amboss' ? 'AMBOSS' : 'Question bank';
  var wdLbl = s.wdHours + ' hrs';
  var weLbl = s.weHours + ' hrs';
  var examISO = examDate.toISOString().slice(0,10);

  return `<!DOCTYPE html>
